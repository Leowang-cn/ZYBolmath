PORT=8910
DATABASE_PATH=./data/app.sqlite
ASSET_BACKEND=local
ASSET_DIR=./data/assets
TARGET_SHEET=三四年级新大纲
EDITOR_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-long-random-value
COOKIE_SECURE=0

# 管理员从页面触发钉钉自动更新。URL 固定由服务器配置，前端不能覆盖。
DINGTALK_DOCUMENT_URL=https://docs.dingtalk.com/i/nodes/N7dx2rn0JbZ9Rq65fNG6YEkPJMGjLRb3
BROWSER_PROFILE_PATH=./data/browser-profile
CHROMIUM_EXECUTABLE_PATH=
CHROMIUM_HEADLESS=1
DINGTALK_EXPORT_TIMEOUT_MS=120000
SYNC_JOB_TIMEOUT_SECONDS=1800
SYNC_JOBS_PATH=./data/sync-jobs.sqlite

# 钉钉页面菜单文字变化时可覆盖，多个候选值用 | 分隔。
DINGTALK_MENU_TEXT='更多|菜单|文件'
DINGTALK_EXPORT_TEXT='下载|导出'
DINGTALK_EXCEL_TEXT='Excel|XLSX|表格'

# 使用 MinIO 时设置 ASSET_BACKEND=minio，并填写以下配置。
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_BUCKET_RAW=vf-dev-raw
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=